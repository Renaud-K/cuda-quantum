# Script mode (cmake -P), run by cudaq_realtime_add_device_code: embed the
# fatbins in FATBINS ('|'-separated) as the cudaq_device_image_t array SYMBOL,
# writing its definition to SOURCE and its declaration to HEADER.

string(REPLACE "|" ";" fatbins "${FATBINS}")

set(images "")
set(entries "")
set(index 0)
foreach(fatbin IN LISTS fatbins)
  file(READ "${fatbin}" bytes HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
  string(REGEX REPLACE "((0x..,){16})" "\\1\n" bytes "${bytes}")
  get_filename_component(name "${fatbin}" NAME)
  string(APPEND images
    "// ${name}\nalignas(8) const unsigned char image_${index}[] = {\n${bytes}};\n\n")
  string(APPEND entries "    {image_${index}, sizeof(image_${index})},\n")
  math(EXPR index "${index} + 1")
endforeach()

get_filename_component(header_name "${HEADER}" NAME)
file(WRITE "${HEADER}" "\
// Generated by cudaq_realtime_add_device_code; do not edit.
#pragma once

#include \"cudaq/realtime/daemon/dispatcher/device_code.h\"

#ifdef __cplusplus
extern \"C\" {
#endif

__attribute__((visibility(\"hidden\"))) extern const cudaq_device_image_t
    ${SYMBOL}[];
__attribute__((visibility(\"hidden\"))) extern const size_t ${SYMBOL}_count;

#ifdef __cplusplus
}
#endif
")

file(WRITE "${SOURCE}" "\
// Generated by cudaq_realtime_add_device_code; do not edit.
#include \"${header_name}\"

namespace {
${images}} // namespace

extern \"C\" {
const cudaq_device_image_t ${SYMBOL}[] = {
${entries}};
const size_t ${SYMBOL}_count = ${index};
}
")
